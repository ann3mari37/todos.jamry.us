{
  "name": "momentum-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:app": "npm --prefix ../app ci && npm --prefix ../app run build:web && node -e \"require('fs').rmSync('../app/dist/_redirects',{force:true})\"",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
